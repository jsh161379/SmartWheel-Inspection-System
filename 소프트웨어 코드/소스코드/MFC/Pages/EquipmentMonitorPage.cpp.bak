    ON_WM_MOUSEWHEEL()

    ON_BN_CLICKED(
        ApplyScenario,
        &CEquipmentMonitorPage::OnApplyScenario)

    ON_CBN_SELCHANGE(
        EquipmentFilter,
        &CEquipmentMonitorPage::OnFilterChanged)

    ON_CBN_SELCHANGE(
        LevelFilter,
        &CEquipmentMonitorPage::OnFilterChanged)

    ON_NOTIFY(
        NM_CUSTOMDRAW,
        LogList,
        &CEquipmentMonitorPage::OnLogCustomDraw)

