
#include "pch.h"
#include "EquipmentMonitorPage.h"

#include <cstdlib>
#include <winhttp.h>
#include <memory>
#pragma comment(lib, "winhttp.lib")

namespace
{
    constexpr UINT EquipmentFilter = 3101;
    constexpr UINT LevelFilter = 3102;
    constexpr UINT Scenario = 3103;
    constexpr UINT ApplyScenario = 3104;
    constexpr UINT LogList = 3105;
    constexpr UINT WM_CAMERA_FRAME = WM_APP + 433;

    constexpr size_t MaxEvents = 1000;

    inline int MaxInt(int a, int b) { return a > b ? a : b; }
    inline int MinInt(int a, int b) { return a < b ? a : b; }

    const COLORREF Navy = RGB(31, 53, 78);
    const COLORREF Muted = RGB(112, 130, 151);
    const COLORREF Blue = RGB(61, 145, 218);
    const COLORREF Border = RGB(221, 231, 241);
    const COLORREF White = RGB(255, 255, 255);
    const COLORREF CameraBg = RGB(25, 42, 62);
    const COLORREF CameraText = RGB(195, 211, 229);

    const LPCTSTR Names[] =
    {
        _T("Conveyor"),
        _T("Camera"),
        _T("검사 판정"),
        _T("Servo"),
        _T("Raspberry Pi"),
        _T("TCP/IP"),
        _T("LED / Buzzer"),
        _T("운전 모드")
    };
}

BEGIN_MESSAGE_MAP(CEquipmentMonitorPage, CBasePage)
    ON_WM_PAINT()
    ON_MESSAGE(WM_CAMERA_FRAME, &CEquipmentMonitorPage::OnCameraFrame)
    ON_WM_SIZE()
