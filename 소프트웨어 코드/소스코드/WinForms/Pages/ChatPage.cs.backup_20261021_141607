    private void ReflowMessages()
    {
        if (messageFlow.ClientSize.Width <= 0)
            return;

        int width =
            Math.Max(
                500,
                messageFlow.ClientSize.Width - 40);

        foreach (Control control
                 in messageFlow.Controls)
        {
            if (control is not Panel wrapper)
                continue;

            wrapper.Width = width;

            if (wrapper.Tag is bool isMine &&
                wrapper.Controls.Count > 0)
            {
                PositionBubble(
                    wrapper,
                    wrapper.Controls[0],
                    isMine);
            }
            else if (
                wrapper.Tag is string tag &&
                tag == "SYSTEM" &&
                wrapper.Controls.Count > 0)
            {
                Control content =
                    wrapper.Controls[0];

                content.Left =
                    Math.Max(
                        0,
                        (wrapper.Width -
                         content.Width) / 2);
            }
        }
    }

    private static void PositionBubble(
        Panel wrapper,
        Control bubble,
        bool isMine)
    {
        bubble.Top = 2;

        bubble.Left =
            isMine
                ? Math.Max(
                    0,
                    wrapper.Width -
                    bubble.Width -
                    8)
                : 8;
    }

