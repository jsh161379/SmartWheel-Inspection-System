    private async Task ConnectAsync()
    {
        reconnectButton.Enabled = false;

        SetConnectionState(
            false,
            "● 중앙 서버 연결 중...");

        await DisconnectAsync();

        try
        {
            var newClient =
                new TcpClient();

            using var timeout =
                new CancellationTokenSource(
                    TimeSpan.FromSeconds(5));

            await newClient.ConnectAsync(
                ServerAddress,
                ServerPort,
                timeout.Token);

            NetworkStream stream =
                newClient.GetStream();

            var newReader =
                new StreamReader(
                    stream,
                    new UTF8Encoding(false),
                    false,
                    1024,
                    true);

            var newWriter =
                new StreamWriter(
                    stream,
                    new UTF8Encoding(false),
                    1024,
                    true)
                {
                    AutoFlush = true,
                    NewLine = "\n"
                };

            client = newClient;
            reader = newReader;
            writer = newWriter;

            connectionCancellation =
                new CancellationTokenSource();

            SetConnectionState(
                true,
                "● 서버 연결됨");

            ClearMessages();
            loadedHistoryCount = 0;

            _ = ReceiveLoopAsync(
                newClient,
                newReader,
                connectionCancellation.Token);

            await RequestChatHistoryAsync(
                newWriter);

            messageBox.Focus();
        }
        catch (OperationCanceledException)
        {
            SetConnectionState(
                false,
                "● 서버 연결 시간 초과");

            AddSystemMessage(
                "중앙 서버 연결 시간이 초과되었습니다.");
        }
        catch (Exception ex)
        {
            SetConnectionState(
                false,
                "● 서버 연결 실패");

            AddSystemMessage(
                $"연결 오류: {ex.Message}");
        }
        finally
        {
            reconnectButton.Enabled = true;
        }
    }

    private async void MessageBox_KeyDown(
        object? sender,
        KeyEventArgs e)
    {
        if (e.KeyCode != Keys.Enter ||
            e.Shift)
        {
            return;
        }

        e.SuppressKeyPress = true;

        await SendCurrentMessageAsync();
    }

    private async Task SendCurrentMessageAsync()
    {
        string message =
            messageBox.Text.Trim();

        if (message.Length == 0)
            return;

        StreamWriter? activeWriter =
            writer;

        if (client?.Connected != true ||
            activeWriter is null)
        {
            SetConnectionState(
                false,
                "● 서버 미연결 · 재연결 필요");

            AddSystemMessage(
                "서버에 연결되어 있지 않습니다.");

            return;
        }

        string json =
            JsonSerializer.Serialize(
                new
                {
                    type = "CHAT",
                    user_name = userName,
                    role,
                    message
                },
                JsonOptions);

        try
        {
            await sendLock.WaitAsync();

            try
            {
                await activeWriter.WriteLineAsync(
                    json);
            }
            finally
            {
                sendLock.Release();
            }

            messageBox.Clear();
            messageBox.Focus();
        }
        catch (Exception ex)
        {
            AddSystemMessage(
                $"전송 오류: {ex.Message}");

            SetConnectionState(
                false,
                "● 메시지 전송 실패");

            await DisconnectAsync();
        }
    }

    private async Task ReceiveLoopAsync(
        TcpClient activeClient,
        StreamReader activeReader,
        CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                string? line =
                    await activeReader.ReadLineAsync(
                        cancellationToken);

                if (line is null)
                    break;

                ProcessServerMessage(line);
            }
        }
        catch (OperationCanceledException)
            when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception)
            when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            AddSystemMessage(
                $"수신 오류: {ex.Message}");
        }
        finally
        {
            if (ReferenceEquals(
                    client,
                    activeClient))
            {
                await DisconnectAsync(
                    activeClient);

                if (!disposed)
                {
                    SetConnectionState(
                        false,
                        "● 서버 연결 끊김");
                }
            }
        }
    }

    public async Task RequestRealInspectionHistoryAsync()
    {
        var activeWriter = writer;
        if (client?.Connected != true || activeWriter is null) return;
        await sendLock.WaitAsync();
        try { await activeWriter.WriteLineAsync("{\"type\":\"DASHBOARD_STATS\"}"); }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine(ex.Message); }
        finally { sendLock.Release(); }
    }

    private void ProcessServerMessage(
        string line)
    {
        try
        {
            using JsonDocument document =
                JsonDocument.Parse(line);

            JsonElement root =
                document.RootElement;

            if (!root.TryGetProperty(
                    "type",
                    out JsonElement typeElement))
            {
                return;
            }

            string type =
                typeElement.GetString() ?? "";

            if (type.Equals("HEARTBEAT", StringComparison.OrdinalIgnoreCase))
            {
                HeartbeatReceived?.Invoke();
                return;
            }

            if (string.Equals(type, "DASHBOARD_STATS_RESULT", StringComparison.OrdinalIgnoreCase))
            {
                if (root.TryGetProperty("recent", out var recent))
                    RealInspectionHistoryReceived?.Invoke(recent.GetString() ?? "");
                return;
            }
            if (string.Equals(type, "INSPECTION", StringComparison.OrdinalIgnoreCase))
            {
                if (root.TryGetProperty("data_source", out var source) && source.GetString() == "HARDWARE")
                    _ = RequestRealInspectionHistoryAsync();
                return;
            }

            if (string.Equals(
                    type,
                    "CHAT_HISTORY_END",
                    StringComparison.OrdinalIgnoreCase))
            {
                loadedHistoryCount = 0;
                return;
            }

            if (!string.Equals(
                    type,
                    "CHAT",
                    StringComparison.OrdinalIgnoreCase))
            {
                return;
            }

            string receivedUser =
                root.TryGetProperty(
                    "user_name",
                    out JsonElement userElement)
                    ? userElement.GetString()
                        ?? "알 수 없음"
                    : "알 수 없음";

            string receivedRole =
                root.TryGetProperty(
                    "role",
                    out JsonElement roleElement)
                    ? roleElement.GetString()
                        ?? string.Empty
                    : string.Empty;

            string receivedMessage =
                root.TryGetProperty(
                    "message",
                    out JsonElement messageElement)
                    ? messageElement.GetString()
                        ?? string.Empty
                    : string.Empty;

            bool isHistory =
                root.TryGetProperty(
                    "history",
                    out JsonElement historyElement) &&
                historyElement.ValueKind ==
                    JsonValueKind.True;

            string displayTime =
                DateTime.Now.ToString(
                    "HH:mm:ss");

            if (root.TryGetProperty(
                    "created_at",
                    out JsonElement createdElement))
            {
                string? createdAt =
                    createdElement.GetString();

                if (DateTime.TryParse(
                        createdAt,
                        out DateTime parsed))
                {
                    displayTime =
                        isHistory
                            ? parsed.ToString(
                                "MM-dd HH:mm")
                            : parsed.ToString(
                                "HH:mm:ss");
                }
            }

            if (isHistory)
                loadedHistoryCount++;

            AddChatMessage(
                displayTime,
                GetRoleName(receivedRole),
                receivedUser,
                receivedMessage,
                receivedUser == userName);
        }
        catch (JsonException)
        {
            AddSystemMessage(
                "잘못된 채팅 데이터가 수신되었습니다.");
        }
    }

    private async Task RequestChatHistoryAsync(
        StreamWriter activeWriter)
    {
        string request =
            JsonSerializer.Serialize(
                new
                {
                    type = "CHAT_HISTORY"
                },
                JsonOptions);

        await sendLock.WaitAsync();

        try
        {
            await activeWriter.WriteLineAsync(
                request);
        }
        finally
        {
            sendLock.Release();
        }
    }

